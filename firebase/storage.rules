rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto do perfil, enviada no cadastro (AuthProvider.sendImageToStorage)
    // e na edição do perfil (UserProvider.sendImageToStorage).
    match /imagens/usuarios/{uid}/foto.png {
      // Qualquer usuário logado vê as fotos (lista da home)
      allow read: if request.auth != null;

      // Só o dono envia a própria foto. No cadastro o email ainda não foi
      // verificado, por isso não é exigido aqui. A imagem é redimensionada
      // para 150x150 no app, então 1 MB é folga mais que suficiente.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.contentType.matches("image/.*")
                   && request.resource.size < 1 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Qualquer outro caminho fica bloqueado
    match /{todosOsCaminhos=**} {
      allow read, write: if false;
    }
  }
}
